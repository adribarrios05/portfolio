---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; home?: boolean }
const { title = `${profile.name} — Software Developer`, description = 'Portfolio de Adrián Barrios. Desarrollo de software, backend y datos. Explora proyectos, arquitectura y decisiones técnicas.', home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#080808"/>
    <meta name="description" content={description}/>
    <meta name="author" content={profile.name}/>
    <title>{title}</title>
    <link rel="canonical" href={canonical}/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta property="og:type" content="website"/>
    <meta property="og:locale" content="es_ES"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={socialImage}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Adrián Barrios — Desarrollador de software junior. Aplicaciones web, multiplataforma y APIs."/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={socialImage}/>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header home={home}/>
    <main id="main"><slot/></main>
    <Footer/>
    <script>import '../scripts/interactions';</script>
  </body>
</html>
