---
import { withBase } from '../../utils/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import Arrow from '../../components/Arrow.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project }
const { project } = Astro.props;
const otherProjects = projects.filter((item) => item.slug !== project.slug);
---
<BaseLayout title={`${project.name} — Caso de estudio | Adrián Barrios`} description={`${project.summary} Arquitectura, alcance y decisiones técnicas del proyecto ${project.name}.`}>
  <div class="case-study container">
    <a class="back-link mono" href={withBase('/#projects')}>← VOLVER A PROYECTOS</a>
    <header class="case-header"><div class="project-meta mono"><span>CASE STUDY / {project.number}</span><span class="status"><i></i>{project.status}</span></div><h1>{project.name}</h1><p class="case-lead">{project.summary}</p><p class="case-summary">{project.problem}</p><ul class="tags">{project.technologies.map((technology) => <li>{technology}</li>)}</ul><span class="case-kind mono">PROYECTO PERSONAL</span></header>
    <figure class="case-figure">{project.image ? <img src={withBase(project.image.src)} alt={project.image.alt} width={project.image.width} height={project.image.height} fetchpriority="high"/> : <ProjectVisual type={project.visual} large/>}<figcaption>{project.image ? 'Captura del proyecto.' : 'Composición técnica ilustrativa. No es una captura de la aplicación.'}</figcaption></figure>
    <div class="case-body"><aside class="case-index"><span class="mono">EN ESTE PROYECTO</span><nav aria-label="Índice del caso de estudio">{project.sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}</nav></aside><div class="case-content">
      {project.sections.map((section, index) => <section id={section.id} class="case-section" data-reveal><span class="eyebrow">{String(index + 1).padStart(2, '0')} /</span><h2>{section.title}</h2>{section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}{section.id === 'architecture' && <ol class="architecture-flow" aria-label="Componentes de la arquitectura">{project.architecture.map((node) => <li><h3>{node.name}</h3><span>{node.detail}</span></li>)}</ol>}{section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}{section.id === 'media' && <div class="media-pending"><span class="mono">CAPTURAS / DEMO</span><p>Pendientes de incorporar.</p></div>}</section>)}
      <section class="case-section evidence-section" data-reveal><span class="eyebrow">ESTADO Y ENLACES</span><h2>Sobre este proyecto.</h2><p>{project.evidence}</p><div class="project-links">{project.repository ? <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">Repositorio<Arrow diagonal/><span class="sr-only"> (nueva pestaña)</span></a> : project.sourceNotice && <span class="pending-note">{project.sourceNotice}</span>}{project.demo && <a class="text-link" href={project.demo} target="_blank" rel="noopener noreferrer">{project.demoLabel || 'Demo'}<Arrow diagonal/><span class="sr-only"> (nueva pestaña)</span></a>}</div></section>
    </div></div>
    {otherProjects.map((other) => <a class="next-project" href={withBase(`/projects/${other.slug}/`)}><div><span class="eyebrow">SIGUIENTE PROYECTO</span><h2>{other.name}</h2></div><Arrow diagonal/></a>)}
    <a class="text-link case-contact" href={withBase('/#contact')}>Hablemos de software<Arrow/></a>
  </div>
</BaseLayout>
