---
import type { Project } from '../data/projects';
import ProjectVisual from './ProjectVisual.astro';
import Arrow from './Arrow.astro';
interface Props { project: Project }
const { project } = Astro.props;
---
<article class="project-card" data-reveal>
  <a class="project-image-link" href={`/projects/${project.slug}/`} aria-label={`Leer el caso de estudio de ${project.name}`}>
    {project.image ? <img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} loading="lazy" decoding="async"/> : <ProjectVisual type={project.visual}/>}
    <span class="visual-caption mono">{project.image ? 'Captura del proyecto' : 'Composición técnica · ilustrativa'}</span>
    <span class="project-image-arrow"><Arrow diagonal/></span>
  </a>
  <div class="project-card-body">
    <div class="project-meta mono"><span>{project.number} / {project.category}</span><span class="status"><i></i>{project.status}</span></div>
    <h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3>
    <p class="project-summary">{project.summary}</p>
    <p class="project-problem">{project.problem}</p>
    <ul class="tags" aria-label="Tecnologías">{project.technologies.map((technology) => <li>{technology}</li>)}</ul>
    <div class="project-links"><a class="text-link" href={`/projects/${project.slug}/`}>Explorar proyecto<Arrow/></a>
      {project.repository && <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">Código<Arrow diagonal/><span class="sr-only"> (nueva pestaña)</span></a>}
      {project.demo && <a class="text-link" href={project.demo} target="_blank" rel="noopener noreferrer">{project.demoLabel || 'Demo'}<Arrow diagonal/><span class="sr-only"> (nueva pestaña)</span></a>}
    </div>
  </div>
</article>
